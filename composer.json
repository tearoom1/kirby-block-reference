{
  "name": "tearoom1/kirby-block-reference",
  "description": "Kirby plugin to reference blocks in other pages",
  "license": "MIT",
  "version": "1.0.9",
  "type": "kirby-plugin",
  "keywords": [
    "kirby",
    "block"
  ],
  "authors": [
    {
      "name": "Mathis Koblin",
      "email": "mail@tearoom.one",
      "homepage": "https://www.tearoom.one",
      "role": "Maintainer"
    }
  ],
  "support": {
    "docs": "https://github.com/tearoom1/kirby-block-reference/blob/main/README.md",
    "source": "https://github.com/tearoom1/kirby-block-reference"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tearoom1/kirby-block-reference.git"
  },
  "require": {
    "php": ">=8.1",
    "getkirby/composer-installer": "^1.1"
  },
  "conflict": {
    "getkirby/cms": "<4.0"
  },
  "require-dev": {
    "getkirby/cms": "^4.0 || ^5.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "TearoomOne\\BlockReference\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    }
  }
}
